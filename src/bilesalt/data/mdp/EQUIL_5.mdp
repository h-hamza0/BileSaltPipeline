define                   = -DPOSRES
title                    = Martini_EQUIL
integrator               = md
dt                       = 0.005 
nsteps                   = 2000000
nstcomm                  = 100

nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 10000 
nstenergy                = 100   
nstxtcout                = 1000  
xtc_precision            = 100

cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.2
ns_type                  = grid
pbc                      = xyz
verlet-buffer-tolerance  = 0.005

coulombtype              = reaction-field
coulomb-modifier         = Potential-shift-verlet
rcoulomb                 = 1.2
epsilon_r                = 15	
epsilon_rf               = 0 
vdw-modifier             = Potential-shift-verlet 
vdw_type                 = cutoff
rvdw                     = 1.2 
rvdw-switch              = 0.9

tcoupl                   = v-rescale 
tc-grps                  = BIL SOLV
tau_t                    = 1.0  1.0 
ref_t                    = 298  298 
Pcoupl                   = Berendsen
Pcoupltype               = isotropic
tau_p                    = 12.0  
compressibility          = 3e-4
ref_p                    = 1.0 

gen_vel                  = yes
gen_temp                 = 298
gen_seed                 = 473529

constraints              = none 
constraint_algorithm     = Lincs
continuation             = no
