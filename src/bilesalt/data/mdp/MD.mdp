;define                   = -DFLEXIBLE
title                    = Martini_MD
integrator               = md
dt                       = 0.020 
nsteps                   = 100000000
nstcomm                  = 100
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 10000 
nstenergy                = 100   
nstxtcout                = 1000 
xtc_precision            = 100
compressed-x-grps        = BIL

cutoff-scheme            = Verlet
nstlist                  = 20
ns_type                  = grid
pbc                      = xyz
verlet-buffer-tolerance  = 0.005

coulombtype              = reaction-field
coulomb-modifier         = Potential-shift-verlet
rcoulomb                 = 1.2
epsilon_r                = 15	
epsilon_rf               = 0 
vdw_type                 = cutoff 
vdw-modifier             = Potential-shift-verlet 
rvdw                     = 1.2
rvdw-swtich              = 0.9 

tcoupl                   = v-rescale 
tc-grps                  = BIL SOLV
tau_t                    = 1.0  1.0 
ref_t                    = 298  298 
Pcoupl                   = Berendsen
Pcoupltype               = isotropic
tau_p                    = 12.0  
compressibility          = 3e-4
ref_p                    = 1.0 

gen_vel                  = no

constraints              = none
constraint_algorithm     = Lincs
continuation             = yes
