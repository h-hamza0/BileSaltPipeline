define                  = -DFLEXIBLE
integrator               = steep
nsteps                   = 500000
nstxout                  = 1000
nstfout                  = 0
nstlog                   = 100 
emtol                    = 1000
emstep                   = 0.001

cutoff-scheme            = Verlet
nstlist                  = 20
ns_type                  = grid
pbc                      = xyz
verlet-buffer-tolerance  = 0.005
rlist                    = 1.1

coulombtype              = PME
rcoulomb                 = 1.1
epsilon_r                = 15    
epsilon_rf               = 0
vdw_type                 = cutoff  
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1
periodic-molecules       = no
constraints              = h-bonds
